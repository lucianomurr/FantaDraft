# Google Analytics (misurazione landing) — opzionale
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# URL pubblico del sito (per sitemap/OG) — impostare dopo il deploy
NEXT_PUBLIC_SITE_URL=https://fantadraft.murruni.it
# tratto.email — API key e indirizzi per le notifiche iscrizione
TRATTO_KEY=
NOTIFY_TO=luciano.murruni@gmail.com
FROM_EMAIL=noreply@fantadraft.murruni.it

# API-Football (api-football.com, piano free) — usata SOLO offline da
# scripts/get_transfers.py per il refresh dei trasferimenti, mai dal sito live.
API_FOOTBALL_KEY=

# Upstash Redis (REST API) — sync multi-device per la modalità "Inizia asta".
# Da Vercel: Storage tab -> Create Database -> Upstash for Redis -> connetti
# al progetto "web" (inietta queste env var in automatico). Senza queste due
# var /api/sync risponde 503 e il tool resta local-only (nessun crash).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
